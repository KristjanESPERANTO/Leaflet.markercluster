{
  "name": "@kristjan.esperanto/leaflet.markercluster",
  "version": "3.0.2",
  "description": "Provides beautiful animated Marker clustering functionality for Leaflet.",
  "homepage": "https://kristjanesperanto.github.io/Leaflet.markercluster/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristjanESPERANTO/Leaflet.markercluster.git"
  },
  "bugs": {
    "url": "https://github.com/KristjanESPERANTO/Leaflet.markercluster/issues"
  },
  "author": "Dave Leaver",
  "license": "MIT",
  "type": "module",
  "main": "dist/leaflet.markercluster.js",
  "module": "dist/leaflet.markercluster.js",
  "types": "types/index.d.ts",
  "style": "dist/MarkerCluster.css",
  "sideEffects": false,
  "publishConfig": {
    "tag": "latest",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/leaflet.markercluster.js",
      "default": "./dist/leaflet.markercluster.js"
    },
    "./dist/MarkerCluster.css": "./dist/MarkerCluster.css",
    "./dist/MarkerCluster.Default.css": "./dist/MarkerCluster.Default.css"
  },
  "files": [
    "dist/**/*",
    "types/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "keywords": [
    "gis",
    "map",
    "cluster",
    "leaflet",
    "markers"
  ],
  "peerDependencies": {
    "leaflet": ">=2.0.0-alpha.1"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^13.1.2",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "leaflet": "^2.0.0-alpha.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rollup": "4.63.1",
    "simple-git-hooks": "^2.14.0",
    "sinon": "^22.1.0"
  },
  "scripts": {
    "test": "npm run lint && npm run build && node --import ./spec/setup.js --test spec/suites/*.js",
    "build": "npm run lint:fix && rollup -c build/rollup-config.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint && prettier --check .",
    "lint:fix": "eslint --fix && prettier --write .",
    "prepare": "simple-git-hooks",
    "release": "commit-and-tag-version --config ./changelog.config.json",
    "release:alpha": "commit-and-tag-version --prerelease alpha --config ./changelog.config.json",
    "release:dry": "commit-and-tag-version --dry-run --config ./changelog.config.json"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "unrs-resolver@1.12.2": true
  }
}
